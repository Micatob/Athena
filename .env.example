# Athena Framework Configuration - Environment Variables
# Copy this file to .env and fill in the values

# ========================================================
# API Security (WARNING: Change the API key in production)
# ========================================================
ATHENA_API_KEY=athena_secure_key_123456789
REQUIRE_API_KEY=true
HTTPS_ENABLED=true
MAX_TARGETS_PER_REQUEST=10
SERVER_PORT=5000
SERVER_HOST=0.0.0.0

# ========================================================
# Operational Mode
# ========================================================
# Profile: stealth | balanced | aggressive | debug
AETHELRED_PROFILE=balanced
AETHELRED_STEALTH=true
AETHELRED_SAFE_MODE=true
AETHELRED_AGGRESSIVE=true
AETHELRED_VERBOSE=false

# ========================================================
# Scan Engine Settings
# ========================================================
# Concurrency limit for background scans
SCANNING_THREADS=10
HTTP_TIMEOUT=10
HTTP_MAX_RETRIES=3
MAX_CONNECTIONS=10

# ========================================================
# Compliance & Logging
# ========================================================
LOG_FILE=aethelred.log
LOG_LEVEL=INFO
AUDIT_LOG_FILE=athena_audit.log
AUDIT_LOG_RETENTION_DAYS=90
PCI_AUDIT_ENABLED=true
GDPR_LOGGING_ENABLED=true

# ========================================================
# AI / LLM Integration (optional - pure addon)
# ========================================================
# Provider: gemini | groq | deepseek (default: first key found)
#ATHENA_AI_PROVIDER=groq
# Global model override - applies to ATHENA_AI_PROVIDER's backend only.
#ATHENA_AI_MODEL=openai/gpt-oss-120b
# Per-provider overrides (used for that backend, including failover hops):
#ATHENA_AI_MODEL_GEMINI=gemini-flash-latest
#ATHENA_AI_MODEL_GROQ=openai/gpt-oss-120b
# Google Gemini
#GEMINI_API_KEY=
# Groq (OpenAI-compatible)
#GROQ_API_KEY=
# DeepSeek (OpenAI-compatible)
#DEEPSEEK_API_KEY=

# ========================================================
# Evidence Encryption (optional)
# ========================================================
# Encrypt raw evidence artifacts at rest with Fernet.
# Set a key (Fernet.generate_key()) or leave empty to auto-generate
# a per-store key under evidence/.evidence.key
#ATHENA_ENCRYPT_EVIDENCE=1
#ATHENA_EVIDENCE_KEY=
