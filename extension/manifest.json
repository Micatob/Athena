{
  "manifest_version": 3,
  "name": "Athena Pentest Tool",
  "version": "1.0",
  "description": "Browser extension interface for Athena penetration testing framework",
  "permissions": [
    "activeTab",
    "storage",
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Athena Pentest"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}